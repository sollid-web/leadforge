# Supabase project values. Publishable/anon keys are intended for browser use; RLS is mandatory.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# For older Supabase projects, NEXT_PUBLIC_SUPABASE_ANON_KEY is also supported.

# Public app URL used in transactional emails and link generation.
NEXT_PUBLIC_APP_URL=https://estatelq.example.com

# Server-only. Required for source-token webhook ingestion. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Server-only AES-256-GCM key for encrypted property address and owner details.
# Generate with: openssl rand -base64 32
OWNER_DATA_ENCRYPTION_KEY=YOUR_BASE64_ENCODED_32_BYTE_KEY

# Optional email delivery via Resend. Manager-confirmed agent emails contain summaries only;
# listing-contact inquiries are one-to-one, manually composed, and never sent automatically.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=EstatelQ <noreply@estatelq.example.com>
# Optional: configure a Resend receiving domain and `email.received` webhook for manager-reviewed replies.
RESEND_INBOUND_DOMAIN=
RESEND_WEBHOOK_SECRET=

# Optional server-side AI reply drafting. Drafts are never sent without manager review.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Server-only bearer secret for scheduled source-health checks.
# Generate with: openssl rand -hex 32
CRON_SECRET=REPLACE_WITH_A_RANDOM_SECRET

# Optional server-only RentCast API key for scheduled US listing discovery.
# Do not share this value with the browser or commit it to the repository.
RENTCAST_API_KEY=REPLACE_WITH_RENTCAST_API_KEY

# Optional server-only Untera API key for live international listing searches.
# Search is disabled unless commercial-use permission is confirmed with Untera.
UNTERA_API_KEY=REPLACE_WITH_UNTERA_API_KEY
UNTERA_COMMERCIAL_USE_AUTHORIZED=false
# Saving/importing records is separately disabled unless written listing retention
# and redistribution permission has been confirmed with Untera.
UNTERA_LISTING_REUSE_AUTHORIZED=false

# Stripe test/live server keys. Configure the webhook endpoint at /api/stripe/webhook.
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# Optional contact address included in OpenStreetMap's geocoding client identification.
OPENSTREETMAP_CONTACT_EMAIL=

# Optional separately deployed Python worker. Set only after source authorization and private/TLS deployment.
# URL must end in /runs; use the same 32+ character secret as worker LEADFORGE_WORKER_TOKEN.
LEADFORGE_SCRAPER_WORKER_URL=https://scraper-worker.example.com/runs
LEADFORGE_SCRAPER_WORKER_TOKEN=REPLACE_WITH_A_RANDOM_SECRET
